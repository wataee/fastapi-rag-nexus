# App & Server Configuration
PROJECT_NAME="FastAPI RAG Nexus Engine"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=nexus-super-secret-jwt-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# Database & Vector DB
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=nexus_rag_db
COLLECTION_NAME=nexus_knowledge_docs

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# OpenAI & Embeddings
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=4
